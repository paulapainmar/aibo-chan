{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aibo-chan",
  "main": "src/index.js",
  "compatibility_date": "2026-10-10",
  "placement": { "region": "aws:eu-central-1" },
  "triggers": { "crons": ["0 */6 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aibo-chan",
      "database_id": "2d0ff37e-0fc2-4f61-8c3f-f4a6c097c272"
    }
  ]
}